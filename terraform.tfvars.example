aws_region  = "us-east-1"
environment = "production"

# Deployment options:
# Set deployment_target to "ec2", "ecs", "both", or "none".
# If left commented out, Terraform will interactively prompt you for the value when running 'terraform apply'.
# deployment_target = "ecs"

# EC2 Options (used when deployment_target = "ec2" or "both")
ec2_instance_type = "t3.micro"
key_name          = "shirish-webserver"

# ECS Apps (Lowest compute options: 256 CPU = 0.25 vCPU, 512 Memory = 0.5 GB RAM)
ecs_apps = {
  portfolio = {
    cpu               = 256
    memory            = 512
    container_port    = 3000
    container_image   = "615993872381.dkr.ecr.us-east-1.amazonaws.com/portfolio:latest"
    desired_count     = 1
    priority          = 500
    path_pattern      = "/*"
    health_check_path = "/"
  }
  ams = {
    cpu                 = 256
    memory              = 512
    container_port      = 80
    container_image     = "public.ecr.aws/docker/library/php:7.4-apache"
    desired_count       = 1
    priority            = 200
    host_header_pattern = ["ams.*"]
    path_pattern        = "/ams*"
    health_check_path   = "/"
  }
  musicbook = {
    cpu                 = 256
    memory              = 512
    container_port      = 8000
    container_image     = "public.ecr.aws/docker/library/php:7.4-fpm-alpine"
    desired_count       = 1
    priority            = 300
    host_header_pattern = ["musicbook.*"]
    path_pattern        = "/musicbook*"
    health_check_path   = "/"
  }
}
